{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "~/.config/opencode/**": "allow"
    },
    "read": {
      "~/Documents/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/go/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.cache/claude/**": "allow",
      "~/.cargo/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "plugin": ["opencode-wakelock"],
  "instructions": [
    "~/.config/opencode/instructions/parallel-reads.md",
    "~/.config/opencode/instructions/general-guideline.md",
    "~/.config/opencode/instructions/coding-guideline.md",
    "~/.config/opencode/instructions/search-performance.md"
  ],
  "small_model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9router",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      }
    },
    "astronauts": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Astronauts AI Gateway",
      "options": {
        "baseURL": "https://ai-gateway.astronauts.id/v1"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-fable-5": {
          "name": "Claude Fable 5"
        },
        "gpt-5.5-2026-04-23": {
          "name": "GPT-5.5 2026-04-23"
        },
        "gemini/gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "text-embedding-3-small": {
          "name": "Text Embedding 3 Small"
        },
        "gemini/gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5 20251001"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "gemini/gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview"
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini"
        },
        "cohere/rerank-v3.5": {
          "name": "Cohere Rerank v3.5"
        },
        "meta-llama/llama-4-scout": {
          "name": "Llama 4 Scout"
        },
        "voyage/voyage-3-large": {
          "name": "Voyage 3 Large"
        },
        "z-ai/glm-5.2": {
          "name": "GLM 5.2"
        },
        "gpt-4o": {
          "name": "GPT-4o"
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "agent": {
    "explore": {
      "description": "Fast codebase exploration — glob, grep, and targeted file reads",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      },
      "prompt": "{file:~/.config/opencode/prompts/explore-guideline.md}"
    },
    "general": {
      "description": "General-purpose subagent for multi-step tasks not covered by specialized agents",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "subagent",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "question": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "{file:~/.config/opencode/prompts/general-guideline.md}"
    },
    "general-lite": {
      "description": "Low-cost implementation subagent for simple edits, docs, config, and known-file fixes",
      "model": "openai/gpt-5.4-mini",
      "mode": "subagent",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "question": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "{file:~/.config/opencode/prompts/general-lite-guideline.md}"
    },
    "scout": {
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:~/.config/opencode/prompts/scout-guideline.md}",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    },
    "executor": {
      "description": "Execute bash commands, tests, builds, and validation — never suggests fixes, just reports",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      },
      "prompt": "{file:~/.config/opencode/prompts/executor-guideline.md}"
    },
    "reviewer": {
      "description": "Review local working-tree changes — writes timestamped findings to .opencode/reviews/",
      "model": "openai/gpt-5.5",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/reviewer-guideline.md}",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/reviews/**": "allow"
        },
        "write": {
          "**/.opencode/reviews/**": "allow"
        },
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "reviewer-lite": {
      "description": "Low-cost quick review for docs, config, simple diffs, and low-risk code changes",
      "model": "openai/gpt-5.4-mini",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/reviewer-lite-guideline.md}",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/reviews/**": "allow"
        },
        "write": {
          "**/.opencode/reviews/**": "allow"
        },
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "planner": {
      "description": "Clarifies vague BRDs, explores codebase with direct reads, produces TRD + task breakdown",
      "model": "openai/gpt-5.5",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/planner-guideline.md}",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "question": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "frontend-designer": {
      "description": "Frontend/UI implementation expert — builds polished pages, components, responsive layouts, interaction states, and design-system-aligned UI",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/frontend-designer-guideline.md}",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "question": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "ui-reviewer": {
      "description": "UI/UX taste reviewer — critiques frontend changes for visual hierarchy, spacing, responsiveness, accessibility, interaction quality, and design-system fit",
      "model": "openai/gpt-5.5",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/ui-reviewer-guideline.md}",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/reviews/**": "allow"
        },
        "write": {
          "**/.opencode/reviews/**": "allow"
        },
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "orchestrator": {
      "model": "openai/gpt-5.5",
      "mode": "primary",
      "description": "Smart orchestrator — delegates reads to @explore, commands to @executor, web to @scout",
      "prompt": "{file:~/.config/opencode/prompts/orchestrator-guideline.md}",
      "permission": {
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "question": "allow",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "repo_clone": "deny",
        "repo_overview": "deny"
      }
    }
  }
}
