{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "read": {
      "~/Documents/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/go/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.cache/claude/**": "allow",
      "~/.cargo/**": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "~/go/**": "allow"
    }
  },
  "instructions": [
    "~/.config/opencode/instructions/l1-to-l2-handoff.md",
    "~/.config/opencode/instructions/parallel-reads.md",
    "~/.config/opencode/instructions/general-guideline.md",
    "~/.config/opencode/instructions/coding-guideline.md",
    "~/.config/opencode/instructions/search-performance.md",
    "~/.config/opencode/instructions/gh-account-routing.md"
  ],
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "small_model": "opencode-go/deepseek-v4-flash",
  "subagent_depth": 1,
  "default_agent": "orchestrator",
  "agent": {
    "explore": {
      "description": "Fast codebase exploration \u2014 glob, grep, and targeted file reads",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "deny"
        }
      },
      "prompt": "{file:~/.config/opencode/prompts/explore-guideline.md}",
      "options": {}
    },
    "general": {
      "description": "General-purpose subagent for multi-step tasks not covered by specialized agents",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "question": "allow",
        "skill": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "{file:~/.config/opencode/prompts/general-guideline.md}",
      "options": {}
    },
    "scout": {
      "description": "External documentation and dependency research agent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:~/.config/opencode/prompts/scout-guideline.md}",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "allow",
        "task": {
          "*": "deny"
        }
      },
      "options": {}
    },
    "reviewer": {
      "description": "Review local working-tree changes \u2014 writes timestamped findings to .opencode/reviews/",
      "model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/reviewer-guideline.md}",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/reviews/**": "allow"
        },
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "options": {}
    },
    "planner": {
      "description": "Clarifies scope and produces implementation-ready patch plans",
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/planner-guideline.md}",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/plans/**": "allow"
        },
        "question": "allow",
        "skill": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "options": {}
    },
    "frontend-designer": {
      "description": "Frontend/UI implementation expert \u2014 builds polished pages, components, responsive layouts, interaction states, and design-system-aligned UI",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/frontend-designer-guideline.md}",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "question": "allow",
        "skill": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "options": {}
    },
    "ui-reviewer": {
      "description": "UI/UX taste reviewer \u2014 critiques frontend changes for visual hierarchy, spacing, responsiveness, accessibility, interaction quality, and design-system fit",
      "model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/prompts/ui-reviewer-guideline.md}",
      "permission": {
        "task": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": {
          "**/.opencode/reviews/**": "allow"
        },
        "skill": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "options": {}
    },
    "orchestrator": {
      "model": "openai/gpt-5.6-luna",
      "mode": "primary",
      "description": "Smart orchestrator \u2014 owns normal edits and commands; delegates discovery to @explore and web research to @scout",
      "prompt": "{file:~/.config/opencode/prompts/orchestrator-guideline.md}",
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "planner": "allow",
          "frontend-designer": "allow",
          "reviewer": "allow",
          "ui-reviewer": "allow",
          "explore": "allow",
          "scout": "allow"
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "allow",
        "question": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny",
        "repo_clone": "deny",
        "repo_overview": "deny"
      },
      "options": {}
    }
  },
  "shell": "zsh"
}
