{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "read": {
      "~/Documents/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/go/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.cache/claude/**": "allow",
      "~/.cargo/**": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "~/go/**": "allow"
    }
  },
  "instructions": [
    "/Users/abdul.firdaus/.config/opencode/instructions/l1-to-l2-handoff.md",
    "~/.config/opencode/instructions/parallel-reads.md",
    "~/.config/opencode/instructions/general-guideline.md",
    "~/.config/opencode/instructions/coding-guideline.md",
    "~/.config/opencode/instructions/search-performance.md",
    "~/.config/opencode/instructions/gh-account-routing.md"
  ],
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "small_model": "opencode-go/deepseek-v4-flash",
  "subagent_depth": 1,
  "provider": {
